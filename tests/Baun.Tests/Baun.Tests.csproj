<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit.net v3 test projects are stand-alone executables. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Baun.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Baun" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Baun\Baun.csproj" />
    <ProjectReference Include="..\..\src\Baun.Cli\Baun.Cli.csproj" />
    <!-- Referenced both as an analyzer, so the test builds get their steps generated, and as a library for generator tests. -->
    <ProjectReference Include="..\..\src\Baun.SourceGenerators\Baun.SourceGenerators.csproj" OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
