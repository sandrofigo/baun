<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Placeholder for local builds. Releases get the version from the tag, see docs/releasing.md. -->
    <Version>0.0.0-dev</Version>
    <Authors>Sandro Figo</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sandrofigo/baun</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sandrofigo/baun</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Symbol packages (.snupkg) for the nuget.org symbol server. dotnet nuget push pushes them with the packages. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
