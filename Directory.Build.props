<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Authors>Sandro Figo</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sandrofigo/baun</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sandrofigo/baun</RepositoryUrl>
  </PropertyGroup>

</Project>
