<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BaunCli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>baun</ToolCommandName>
    <PackageId>Baun.Cli</PackageId>
    <Description>The baun command-line tool. Runs single-file and project baun builds with the same command.</Description>
    <PackageTags>build;ci;cd;pipeline;automation;tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Baun.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
  </ItemGroup>

</Project>
