<Project>

  <!--
    Hides IDE and MSBuild settings files from the project, so they don't clutter it. This has to be a .targets file,
    because the SDK adds its default None items after .props files are imported.
  -->
  <ItemGroup>
    <None Remove="*.csproj.DotSettings;.editorconfig;Directory.Build.props;Directory.Build.targets" />
  </ItemGroup>

  <!--
    Shows .baun/parameters.json of the nearest .baun folder in the project folder or its parents in a .baun folder of the
    project, so the parameter values are at hand in IDEs.
  -->
  <PropertyGroup>
    <_BaunRepositoryRoot>$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), '.baun/parameters.json'))</_BaunRepositoryRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(_BaunRepositoryRoot)' != ''">
    <None Remove="$(_BaunRepositoryRoot)/.baun/parameters.json" />
    <None Include="$(_BaunRepositoryRoot)/.baun/parameters.json" Link=".baun/parameters.json" />
  </ItemGroup>

</Project>
