<Project>

  <!-- Imports baun's namespaces in every build, so builds don't need using directives for baun's types. -->
  <ItemGroup>
    <Using Include="Baun" />
    <Using Include="Baun.CI" />
    <Using Include="Baun.CI.AzureDevOps" />
    <Using Include="Baun.CI.GitHub" />
    <Using Include="Baun.CI.GitLab" />
    <Using Include="Baun.CI.TeamCity" />
    <Using Include="Baun.Logging" />
    <Using Include="Baun.Tools.DotNet" />
    <Using Include="Baun.Tools.Git" />
  </ItemGroup>

</Project>
