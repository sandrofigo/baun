<Project>

  <!--
    The examples build against the baun source code in this repository instead of the Baun NuGet package.
    The package ships the source generator inside it and imports the Baun namespace; a project reference does
    neither, so both are added here for every example, single-file and project builds alike.
  -->

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Baun" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Baun.SourceGenerators/Baun.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
